PORT=5000

# Prisma (Supabase Postgres connection string)
DATABASE_URL=postgresql://postgres:your_password@db.your-project-ref.supabase.co:5432/postgres?schema=public

# Redis cache
REDIS_URL=redis://localhost:6379
REDIS_DEFAULT_TTL=120

# Supabase — project: universe-platform (ref: aabjnadvxiexodbvmzuc)
SUPABASE_URL=https://aabjnadvxiexodbvmzuc.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# Auth
JWT_SECRET=your_jwt_secret

# OpenAI
OPENAI_API_KEY=your_openai_api_key

# Firebase
FIREBASE_PROJECT_ID=your_firebase_project_id
