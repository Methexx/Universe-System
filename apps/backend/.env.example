# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Database (Supabase Postgres via Prisma) ──────────────────────────────────
# Pooled connection — used by the app at runtime
DATABASE_URL=postgresql://postgres.aabjnadvxiexodbvmzuc:your_password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# Direct connection — used by Prisma migrate (non-pooler)
DIRECT_URL=postgresql://postgres.aabjnadvxiexodbvmzuc:your_password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_DEFAULT_TTL=120

# ─── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://aabjnadvxiexodbvmzuc.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Must be at least 32 characters
JWT_SECRET=your_jwt_secret_min_32_chars

# ─── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxx
RESEND_FROM_EMAIL=noreply@mg.methum.space

# ─── AI / ML ──────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key
OPENAI_API_KEY=your_openai_api_key

# ─── Firebase (Push Notifications) ───────────────────────────────────────────
FIREBASE_PROJECT_ID=your_firebase_project_id
# Full service account JSON as a single-line string (stringify the downloaded JSON)
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# ─── CORS Origins ─────────────────────────────────────────────────────────────
WEB_URL=http://localhost:3000
FLUTTER_ORIGIN=http://localhost:3001
