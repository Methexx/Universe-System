{
  "info": {
    "name": "UniVerse Platform Full API",
    "description": "Complete test suite for Universe Platform API tracking Auth, Users, School, Gate, Attendance, Announcements, and Messages modules.",
    "schema": "https://schema.postman.com/collection/json/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Login (Admin/Teacher)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "if(response.data && response.data.token) {",
                  "    pm.collectionVariables.set('token', response.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@school.lk\",\n  \"password\": \"adminpassword\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"new_parent@school.lk\",\n  \"password\": \"password123\",\n  \"full_name\": \"New Parent Profile\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Users & RBAC",
      "item": [
        {
          "name": "Get Profile (Me)",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/users/me", "host": ["{{baseUrl}}"], "path": ["users", "me"] }
          }
        },
        {
          "name": "Update Profile (Me)",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"full_name\": \"Updated Admin Profile\",\n  \"avatar_url\": \"https://link.to/avatar.jpg\"\n}" },
            "url": { "raw": "{{baseUrl}}/users/me", "host": ["{{baseUrl}}"], "path": ["users", "me"] }
          }
        },
        {
          "name": "Get Pending Users (Admin)",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/users/pending", "host": ["{{baseUrl}}"], "path": ["users", "pending"] }
          }
        },
        {
          "name": "Promote User",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"role\": \"teacher\"\n}" },
            "url": { "raw": "{{baseUrl}}/users/USER_ID_HERE/promote", "host": ["{{baseUrl}}"], "path": ["users", "USER_ID_HERE", "promote"] }
          }
        }
      ]
    },
    {
      "name": "3. School Entity",
      "item": [
        {
          "name": "Create Grade",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Grade 10\"\n}" },
            "url": { "raw": "{{baseUrl}}/school/grades", "host": ["{{baseUrl}}"], "path": ["school", "grades"] }
          }
        },
        {
          "name": "Create Class",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Class A\",\n  \"grade_id\": \"GRADE_ID_HERE\",\n  \"teacher_id\": \"TEACHER_ID_HERE\"\n}" },
            "url": { "raw": "{{baseUrl}}/school/classes", "host": ["{{baseUrl}}"], "path": ["school", "classes"] }
          }
        },
        {
          "name": "Create Student",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"full_name\": \"Amal Perera\",\n  \"student_id_no\": \"SCH-0001\",\n  \"date_of_birth\": \"2010-05-15\",\n  \"class_id\": \"CLASS_ID_HERE\"\n}" },
            "url": { "raw": "{{baseUrl}}/school/students", "host": ["{{baseUrl}}"], "path": ["school", "students"] }
          }
        }
      ]
    },
    {
      "name": "4. Gate",
      "item": [
        {
          "name": "Scan QR Code",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"qr_code\": \"QR_CODE_UUID_HERE\",\n  \"direction\": \"IN\"\n}" },
            "url": { "raw": "{{baseUrl}}/gate/scan", "host": ["{{baseUrl}}"], "path": ["gate", "scan"] }
          }
        },
        {
          "name": "Get Recent Events",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/gate/events/recent", "host": ["{{baseUrl}}"], "path": ["gate", "events", "recent"] }
          }
        }
      ]
    },
    {
      "name": "5. Attendance",
      "item": [
        {
          "name": "Mark Attendance",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"student_id\": \"STUDENT_ID_HERE\",\n  \"status\": \"present\",\n  \"date\": \"2026-03-29\",\n  \"remarks\": \"Arrived on time\"\n}" },
            "url": { "raw": "{{baseUrl}}/attendance", "host": ["{{baseUrl}}"], "path": ["attendance"] }
          }
        },
        {
          "name": "Get Today's Attendance",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/attendance/today", "host": ["{{baseUrl}}"], "path": ["attendance", "today"] }
          }
        }
      ]
    },
    {
      "name": "6. Announcements",
      "item": [
        {
          "name": "Create Announcement",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Tomorrow is a holiday\",\n  \"content\": \"School closed due to heavy rain.\",\n  \"scope\": \"school_wide\",\n  \"target\": \"all\"\n}" },
            "url": { "raw": "{{baseUrl}}/announcements", "host": ["{{baseUrl}}"], "path": ["announcements"] }
          }
        },
        {
          "name": "View Announcements",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/announcements", "host": ["{{baseUrl}}"], "path": ["announcements"] }
          }
        },
        {
          "name": "Delete Announcement",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/announcements/ANNOUNCEMENT_ID_HERE", "host": ["{{baseUrl}}"], "path": ["announcements", "ANNOUNCEMENT_ID_HERE"] }
          }
        }
      ]
    },
    {
      "name": "7. Messages & AI",
      "item": [
        {
          "name": "Get Inbox",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/messages/inbox", "host": ["{{baseUrl}}"], "path": ["messages", "inbox"] }
          }
        },
        {
          "name": "Get Specific Thread",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/messages/thread/USER_ID_HERE", "host": ["{{baseUrl}}"], "path": ["messages", "thread", "USER_ID_HERE"] }
          }
        },
        {
          "name": "Send Message",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"receiver_id\": \"USER_ID_HERE\",\n  \"student_id\": \"STUDENT_ID_HERE\",\n  \"content\": \"Message content goes here.\"\n}" },
            "url": { "raw": "{{baseUrl}}/messages/send", "host": ["{{baseUrl}}"], "path": ["messages", "send"] }
          }
        },
        {
          "name": "Mark Message as Read",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "PUT",
            "url": { "raw": "{{baseUrl}}/messages/MESSAGE_ID_HERE/read", "host": ["{{baseUrl}}"], "path": ["messages", "MESSAGE_ID_HERE", "read"] }
          }
        },
        {
          "name": "Generate AI Draft",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"student_id\": \"STUDENT_ID_HERE\"\n}" },
            "url": { "raw": "{{baseUrl}}/messages/ai-draft", "host": ["{{baseUrl}}"], "path": ["messages", "ai-draft"] }
          }
        }
      ]
    }
  ]
}